# Copie para .env e preencha. Só um provedor é necessário.

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5

# --- Qualquer API compatível com OpenAI (OpenAI, Groq, OpenRouter, Ollama...) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # ex.: http://localhost:11434/v1 para Ollama local
# LLM_MODEL=                  # obrigatório nesse caso, ex.: llama3.1:8b

# Modelo usado como juiz na avaliação do RAG (opcional; padrão = o mesmo do LLM_MODEL)
# JUDGE_MODEL=

# Embeddings: sbert (padrão) ou lsa (sem torch, roda offline)
# EMBEDDING_BACKEND=sbert
# SBERT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Limites de chamadas ao LLM no app (importante se publicar no Streamlit Cloud)
# LLM_SESSION_LIMIT=10
# LLM_DAILY_LIMIT=200
